{
  "name": "Xiaomu",
  "identifier": "dev.arixbit.xiaomu",
  "version": "0.9.6",
  "main": "./cmd/xiaomu",
  "icon": "resources/icon.png",
  "urlSchemes": ["xiaomu"],
  "fileAssociations": [
    {
      "ext": ["mp4", "m4v"],
      "name": "MPEG-4 Video",
      "mimeType": "video/mp4",
      "role": "Viewer"
    },
    {
      "ext": ["mov"],
      "name": "QuickTime Movie",
      "mimeType": "video/quicktime",
      "role": "Viewer"
    },
    {
      "ext": ["m3u8"],
      "name": "HLS Playlist",
      "mimeType": "application/vnd.apple.mpegurl",
      "role": "Viewer"
    },
    {
      "ext": ["mkv"],
      "name": "Matroska Video",
      "mimeType": "video/x-matroska",
      "role": "Viewer"
    },
    {
      "ext": ["webm"],
      "name": "WebM Video",
      "mimeType": "video/webm",
      "role": "Viewer"
    },
    {
      "ext": ["flv"],
      "name": "Flash Video",
      "mimeType": "video/x-flv",
      "role": "Viewer"
    },
    {
      "ext": ["ts", "m2ts"],
      "name": "MPEG Transport Stream",
      "mimeType": "video/mp2t",
      "role": "Viewer"
    },
    {
      "ext": ["avi"],
      "name": "AVI Video",
      "mimeType": "video/x-msvideo",
      "role": "Viewer"
    },
    {
      "ext": ["wmv"],
      "name": "Windows Media Video",
      "mimeType": "video/x-ms-wmv",
      "role": "Viewer"
    },
    {
      "ext": ["mpg", "mpeg"],
      "name": "MPEG Video",
      "mimeType": "video/mpeg",
      "role": "Viewer"
    },
    {
      "ext": ["rmvb"],
      "name": "RealMedia Variable Bitrate",
      "mimeType": "application/vnd.rn-realmedia-vbr",
      "role": "Viewer"
    },
    {
      "ext": ["3gp"],
      "name": "3GPP Video",
      "mimeType": "video/3gpp",
      "role": "Viewer"
    },
    {
      "ext": ["ogv"],
      "name": "Ogg Video",
      "mimeType": "video/ogg",
      "role": "Viewer"
    }
  ],
  "out": "build",
  "updates": {
    "publicKey": "+fHvmj1BfzANUNWPMbHUlnVPJkCBvcFZ26XuzcgYKUI=",
    "github": "arixbit/xiaomu-desktop",
    "deltas": 0
  },
  "macos": {
    "icon": "xiaomu-icon/macos/AppIcon.icns",
    "minimumSystemVersion": "13.0"
  },
  "windows": {
    "displayName": "小幕",
    "installerInclude": "scripts/installer.nsh"
  }
}
